generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Channel {
  INSTAGRAM
  INSTAGRAM_LEAD
  WHATSAPP
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageType {
  TEXT
  LEAD
}

enum QuoteStatus {
  DRAFT
  SENT
}

/// Lifecycle of a conversation as a sales lead.
enum LeadStatus {
  NEW
  QUALIFIED
  QUOTE_SENT
  WON
  LOST
}

model Contact {
  id             String   @id @default(uuid())
  channel        Channel
  /// Provider-side identifier: Instagram-scoped user id, or WhatsApp wa_id.
  externalId     String
  name           String
  phone          String?
  email          String?
  profilePicture String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation?

  @@unique([channel, externalId])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@map("contacts")
}

model Conversation {
  id            String    @id @default(uuid())
  contactId     String    @unique
  channel       Channel
  lastMessage   String?
  lastMessageAt DateTime?
  unreadCount   Int       @default(0)

  // Lead details. Every conversation is a lead, so these live here rather than
  // in a separate table.
  destination String?
  travelMonth String?
  adults      Int?
  children    Int?
  budget      Int?
  status      LeadStatus @default(NEW)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]
  quotes   Quote[]

  @@index([lastMessageAt(sort: Desc)])
  @@index([status])
  @@index([destination])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String
  direction      MessageDirection
  messageType    MessageType      @default(TEXT)
  content        String
  /// Provider message id. Unique, which is what makes ingestion idempotent.
  externalMessageId String?       @unique
  sentAt         DateTime         @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("messages")
}

/// A quotation for a conversation. Immutable once SENT — editing produces a
/// new version rather than changing history.
model Quote {
  id             String      @id @default(uuid())
  conversationId String
  /// 1-based, unique per conversation. The highest version is "the latest".
  version        Int
  status         QuoteStatus @default(DRAFT)
  title          String
  currency       String      @default("INR")
  /// Whole currency units (no minor units) — the consultant types round numbers.
  totalAmount    Int         @default(0)
  validUntil     DateTime
  notes          String?
  /// Object key in MinIO. Null until the PDF has been generated.
  pdfPath        String?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  items        QuoteItem[]

  @@unique([conversationId, version])
  @@index([conversationId])
  @@map("quotes")
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  title       String
  description String?
  quantity    Int
  unitPrice   Int
  /// quantity × unitPrice, always calculated server-side.
  totalPrice  Int
  sortOrder   Int

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
  @@map("quote_items")
}
