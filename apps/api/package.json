{
  "name": "@travel-crm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node -r ts-node/register/transpile-only test/checks.ts && node -r ts-node/register/transpile-only test/api.smoke.ts && node -r ts-node/register/transpile-only test/communication.smoke.ts && node -r ts-node/register/transpile-only test/ai.smoke.ts && node -r ts-node/register/transpile-only test/quotes.smoke.ts",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file-if-exists=../../.env -r ts-node/register/transpile-only prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.2",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.2.1",
    "@travel-crm/sdk": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "minio": "^8.0.4",
    "pdfkit": "^0.16.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.9",
    "eslint": "^9.18.0",
    "prisma": "^6.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
