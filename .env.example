# ---------------------------------------------------------------------------
# Shared / Docker Compose
# ---------------------------------------------------------------------------
POSTGRES_USER=travelcrm
POSTGRES_PASSWORD=travelcrm
POSTGRES_DB=travelcrm

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://travelcrm:travelcrm@localhost:5432/travelcrm?schema=public

# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-minimum-32-characters
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
LOG_LEVEL=log

# Seeded administrator account (there is exactly one)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@travelcrm.test
ADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------------------------
# Meta — Instagram Messaging, Instagram Lead Ads, WhatsApp Cloud API
#
# All optional: leave them blank and the API still boots. The affected channel
# simply reports itself as not connected instead of failing at startup.
# ---------------------------------------------------------------------------
META_GRAPH_VERSION=v21.0
# App Secret from the Meta app dashboard. Used to verify X-Hub-Signature-256 on
# every webhook. REQUIRED in production — without it the API refuses webhooks.
META_APP_SECRET=

# Any string you choose; paste the same value into the Meta webhook setup form.
INSTAGRAM_VERIFY_TOKEN=
# Instagram professional account id that owns the inbox.
INSTAGRAM_ACCOUNT_ID=
# Page access token with instagram_manage_messages + leads_retrieval.
INSTAGRAM_ACCESS_TOKEN=

WHATSAPP_VERIFY_TOKEN=
# Phone number id from WhatsApp Manager (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# OpenAI — the AI assistant in the inbox
#
# Optional. Without a key the assistant reports itself as not connected; the
# rest of the application is unaffected. The key stays server-side and is never
# sent to the browser.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override to point at a compatible gateway or proxy.
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Object storage (MinIO) — generated quote PDFs
# ---------------------------------------------------------------------------
# Reached by the API. Inside Docker Compose this is http://minio:9000
MINIO_ENDPOINT=http://localhost:9000
# Reached by the browser, and by WhatsApp when it fetches a quote PDF.
# Presigned links are signed against this host, so it must be publicly
# reachable for WhatsApp document delivery to work.
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=travel-crm

# ---------------------------------------------------------------------------
# Company identity — printed on quote PDFs
# ---------------------------------------------------------------------------
COMPANY_NAME=Travel CRM
# Absolute path to a PNG or JPEG readable by the API. Left out of the PDF when blank.
COMPANY_LOGO_PATH=
# Optional single line under the company name, e.g. address or phone.
COMPANY_CONTACT=

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# Browser-facing API base URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Public origin the browser reaches the web app on, e.g. https://app.example.com
#
# Set this in any deployment behind a reverse proxy: the incoming request there
# carries the internal bind address, and login redirects are built against this
# instead. Deliberately NOT derived from X-Forwarded-Host, which a client can
# set to anything. Leave blank for local development.
#
# Use the https:// scheme in production. With http:// here, every auth redirect
# lands the browser on plain HTTP — which shows as "Not secure", and the
# session cookie is then withheld because COOKIE_SECURE marks it https-only.
NEXT_PUBLIC_APP_URL=
# Server-side (middleware / RSC) API base URL. Inside Docker use http://api:3001/api/v1
API_INTERNAL_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_NUMBER=local
