# ---------------------------------------------------------------------------
# Shared / Docker Compose
# ---------------------------------------------------------------------------
POSTGRES_USER=travelcrm
POSTGRES_PASSWORD=travelcrm
POSTGRES_DB=travelcrm

# ---------------------------------------------------------------------------
# API (apps/api)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://travelcrm:travelcrm@localhost:5432/travelcrm?schema=public

# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production-minimum-32-characters
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
LOG_LEVEL=log

# Seeded administrator account (there is exactly one)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@travelcrm.test
ADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------------------------
# Meta — Instagram Messaging, Instagram Lead Ads, WhatsApp Cloud API
#
# All optional: leave them blank and the API still boots. The affected channel
# simply reports itself as not connected instead of failing at startup.
# ---------------------------------------------------------------------------
META_GRAPH_VERSION=v21.0
# App Secret from the Meta app dashboard. Used to verify X-Hub-Signature-256 on
# every webhook. REQUIRED in production — without it the API refuses webhooks.
META_APP_SECRET=

# Log the full body of every webhook Meta delivers, for proving connectivity or
# diagnosing a channel. Off by default: payloads carry customer names, phone
# numbers and message text. Turn on, reproduce, turn off.
WEBHOOK_LOG_PAYLOADS=false

# --- Instagram: "API with Instagram Login" ----------------------------------
# NOT the Facebook Page / Messenger flow. Different host, different token, no
# Page and no Page Access Token anywhere in it.
#
# Host and version for every Instagram call. Do not point these at
# graph.facebook.com — Instagram messaging does not live there.
INSTAGRAM_GRAPH_URL=https://graph.instagram.com
INSTAGRAM_GRAPH_VERSION=v23.0
# Any string you choose; paste the same value into the Meta webhook setup form.
# Example: INSTAGRAM_VERIFY_TOKEN=travelcrm_IG_4d9b8b92ab1e
INSTAGRAM_VERIFY_TOKEN=
# App Secret of the Instagram app, for X-Hub-Signature-256 on IG webhooks.
# Falls back to META_APP_SECRET when blank.
INSTAGRAM_APP_SECRET=
# The Instagram professional account that owns the inbox.
INSTAGRAM_BUSINESS_ID=
# Instagram *user* access token with instagram_business_manage_messages.
# Only the cold-start value: refreshes are stored in the database and win.
INSTAGRAM_ACCESS_TOKEN=

WHATSAPP_VERIFY_TOKEN=
# Phone number id from WhatsApp Manager (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Where the links in follow-up and assignment emails point. Set this to the
# address staff actually use, or every reminder will send them to localhost.
APP_URL=http://localhost:3000

# SMTP itself is configured in the application, under Settings → Email, not
# here: the password is encrypted at rest rather than sitting in a file.

# ---------------------------------------------------------------------------
# AI assistant — requirement tidying, summaries and draft replies
#
# Points at a local Ollama server by default. Ollama serves the OpenAI
# chat-completions protocol on /v1, so the same settings also work for any
# OpenAI-compatible gateway.
#
# Optional. Until AI_MODEL is set the assistant reports itself as not switched
# on and every AI button says so; the rest of the application is unaffected.
# Nothing here is ever sent to the browser.
# ---------------------------------------------------------------------------
# Inside Docker Compose, a server on the host is http://host.docker.internal:11434/v1
AI_BASE_URL=http://localhost:11434/v1
# No default on purpose — set this to a model the server actually has.
# `GET /api/v1/ai/status` lists what it has installed, as does `ollama list`.
AI_MODEL=
# Unused by Ollama; required by hosted gateways.
AI_API_KEY=
# Local models on modest hardware are slower than a hosted API.
AI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Object storage (MinIO) — generated quote PDFs
# ---------------------------------------------------------------------------
# Reached by the API. Inside Docker Compose this is http://minio:9000
MINIO_ENDPOINT=http://localhost:9000
# Reached by the browser, and by WhatsApp when it fetches a quote PDF.
# Presigned links are signed against this host, so it must be publicly
# reachable for WhatsApp document delivery to work.
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=travel-crm
# Must be set. Without it the client asks MinIO which region the bucket is in,
# that call fails, and every presigned PDF link fails with it. Any value works.
MINIO_REGION=us-east-1

# ---------------------------------------------------------------------------
# Company identity — printed on quote PDFs
# ---------------------------------------------------------------------------
COMPANY_NAME=Travel CRM
# Absolute path to a PNG or JPEG readable by the API. Left out of the PDF when blank.
COMPANY_LOGO_PATH=
# Optional single line under the company name, e.g. address or phone.
COMPANY_CONTACT=
# The agency's own tax registration, printed on invoices when set.
COMPANY_TAX_ID=
# Free text shown under "How to pay" on invoices: account name, number,
# IFSC, UPI ID — whatever customers actually need to send you money.
COMPANY_BANK_DETAILS=

# ---------------------------------------------------------------------------
# Invoice defaults
# ---------------------------------------------------------------------------
# Prefilled into a new invoice. Every one of them is editable per invoice.
# Days from issue to due.
INVOICE_DUE_DAYS=14
# Basis points: 1800 is 18% GST. Leave EMPTY for no tax by default — that is
# deliberate. GST does not apply to every travel service, and a default rate
# would silently overbill.
INVOICE_DEFAULT_TAX_BPS=
INVOICE_PAYMENT_TERMS=Payment is due by the date shown above. Please quote the invoice number.

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
# Browser-facing API base URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Public origin the browser reaches the web app on, e.g. https://app.example.com
#
# Set this in any deployment behind a reverse proxy: the incoming request there
# carries the internal bind address, and login redirects are built against this
# instead. Deliberately NOT derived from X-Forwarded-Host, which a client can
# set to anything. Leave blank for local development.
#
# Use the https:// scheme in production. With http:// here, every auth redirect
# lands the browser on plain HTTP — which shows as "Not secure", and the
# session cookie is then withheld because COOKIE_SECURE marks it https-only.
NEXT_PUBLIC_APP_URL=
# Server-side (middleware / RSC) API base URL. Inside Docker use http://api:3001/api/v1
API_INTERNAL_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_NUMBER=local

# Where generated documents land if MinIO is unreachable.
STORAGE_DIR=storage
# This API's own public base, for links to locally stored documents.
API_URL=http://localhost:3001
